{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "../dist-electron",
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../shared/src/**/*.ts"
  ]
}
